(version 1)
(rule "Pour clearance to controlled impedance"
	(condition "A.Type == 'Zone' && B.Type == 'Track' && B.hasNetclass('90Ohm-diff_USB')")
	(constraint clearance (min 0.3mm)))
(rule "USB pairs"
	(condition "A.hasNetclass('90Ohm-diff_USB')")
	(constraint skew (max 0.127mm) (within_diff_pairs))
	(constraint diff_pair_uncoupled (max 10mm))
	(constraint via_count (max 2)))
(rule "DUT power path"
	(condition "A.hasNetclass('Power_3A')")
	(constraint track_width (min 1mm)))
