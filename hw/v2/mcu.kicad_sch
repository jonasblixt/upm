	(text "VDDIN: 10 uF + 100 nF; VDDANA: 1 uF + 100 nF; VDDCORE: 1 uF + 100 nF (one pair per pin, at the pin)"
		(exclude_from_sim no)
		(at 40.64 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "62291964-e726-408d-a0c3-5354e5be8866")
	)
	(text "J1 (host) is a sink: Rd 5.1 kOhm on each CC; the MCU reads the host's Rp level\n(default / 1.5 A / 3 A) on AIN18/AIN19 through 10 kOhm."
		(exclude_from_sim no)
		(at 292.1 177.8 0)
		(effects
