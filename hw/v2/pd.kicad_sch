	)
	(text "U1, J4 PD power in (sink): ADCIN1 = LDO_3V3 (7), ADCIN2 = LDO_1V5 (5): AlwaysEnableSink, I2C target 0x20.\nSinks 5 V onto VIN_HV before any configuration, so J4 alone powers the UPM; PD stays off until the MCU loads the patch bundle."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
