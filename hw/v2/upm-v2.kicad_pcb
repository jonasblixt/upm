	(gr_text "1. Board 79.5 x 60.0 x 1.6 mm. It slides into the extrusion's card guides along"
		(locked yes)
		(at 30 128.4 0)
		(layer "User.1")
		(uuid "d464042c-d4b5-4274-95a7-6145b31cd97b")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   the 79.5 mm edges and is held by the two bezels. No mounting holes."
		(locked yes)
		(at 30 130.8 0)
		(layer "User.1")
		(uuid "d512fa7f-c1b1-4600-ac4d-a6e25b3d0e27")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "2. Length: the extrusion is 81.0 ±0.5 and each bezel reaches 0.5 into it, which leaves"
		(locked yes)
		(at 30 133.2 0)
		(layer "User.1")
		(uuid "a94775d3-4183-445c-be3e-3ac4f90b085f")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   79.5 to 80.5 mm between the bezels. 79.5 fits the shortest."
		(locked yes)
		(at 30 135.6 0)
		(layer "User.1")
		(uuid "d7716f09-1905-4edd-807b-0a6507a2e852")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "3. Width: the guides are 61.88 ±0.51 apart at their bottoms and 2.29 deep, 1.63 high."
		(locked yes)
		(at 30 138 0)
		(layer "User.1")
		(uuid "8bfab18c-9e5f-44a3-9180-6eee6b5404c4")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "4. Rail strips, 3.0 mm along both long edges, both sides: no parts, no copper on L1 / L4,"
		(locked yes)
		(at 30 140.4 0)
		(layer "User.1")
		(uuid "d48e87a5-3a92-4c99-8ab6-c01af1c8c02c")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   no solder mask. Bare, they are about 1.53 mm thick on a nominal board."
		(locked yes)
		(at 30 142.8 0)
		(layer "User.1")
		(uuid "1e315b26-62d7-49b5-95a4-c0b0ef8bae76")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "5. Clear height 4.45 mm above the top side and 2.92 mm below the bottom side."
		(locked yes)
		(at 30 145.2 0)
		(layer "User.1")
		(uuid "5ce2bc4e-ec85-4996-a4b1-572d37c5dff6")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   Design to 4.0 and 2.5 mm."
		(locked yes)
		(at 30 147.6 0)
		(layer "User.1")
		(uuid "7be20910-d342-4ae9-b9d1-124bf2ae81f0")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "6. Bezels: 2.5 mm thick over a 55.5 x 8.86 mm panel area, centred. The board's top face"
		(locked yes)
		(at 30 150 0)
		(layer "User.1")
		(uuid "43e3872c-63fd-49eb-b410-e1385a3dc268")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   is on the centre line of the bezel."
		(locked yes)
		(at 30 152.4 0)
		(layer "User.1")
		(uuid "166c7967-4d48-4d41-bf58-5d03d7585a03")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "7. USB-C, both bezels: Wurth 632723130112 in a 9.5 x 4.7 mm cut-out, mating face"
		(locked yes)
		(at 30 154.8 0)
		(layer "User.1")
		(uuid "9d2a0f14-1c3a-4915-965d-fcd7a2c9a0a5")
		(effects
