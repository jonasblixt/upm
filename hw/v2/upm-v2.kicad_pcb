	(gr_text "1. Build to IPC-6012 Class 2. 4-layer rigid FR-4, Tg >= 150 °C, rated for lead-free assembly."
		(at 30 159 0)
		(layer "User.3")
		(uuid "6385692f-8eda-4d57-9a6d-449dd914bd68")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   Reference build: JLCPCB stackup JLC04161H-2116, Tg 155 option."
		(at 30 161.4 0)
		(layer "User.3")
		(uuid "68e950ab-30aa-4163-bbdc-156077437b11")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "2. Finished board thickness 1.60 mm ±10 %."
		(at 30 163.8 0)
		(layer "User.3")
		(uuid "32be3279-2715-4bd6-9a30-65e3249e3604")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "3. Finished copper: outer layers 1 oz (35 µm), inner layers 0.5 oz."
		(at 30 166.2 0)
		(layer "User.3")
		(uuid "178af612-ebdb-415b-a800-075a1121ef25")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "4. Layer order and use per the stackup table. Dielectric thicknesses are nominal; other"
		(at 30 168.6 0)
		(layer "User.3")
		(uuid "a0d0d0a5-c257-4361-9eb5-b036bae3c93c")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   materials and constructions are acceptable if the impedance targets and the finished"
		(at 30 171 0)
		(layer "User.3")
		(uuid "1a7595af-c822-41f5-9eb5-3443284db546")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   thickness are met and L1-L2 and L3-L4 each stay <= 0.15 mm."
		(at 30 173.4 0)
		(layer "User.3")
		(uuid "36a65162-b3e9-44c1-b170-ced5e9bb3250")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "5. Controlled impedance per the table, ±10 %. The fab may change the width of controlled"
		(at 30 175.8 0)
		(layer "User.3")
		(uuid "b737857d-6cad-435f-95be-8e7aef118f3d")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   traces by up to ±0.025 mm (keeping the pair pitch) to meet the targets. No TDR report needed."
		(at 30 178.2 0)
		(layer "User.3")
		(uuid "114ee787-147a-455d-9a43-4b66e0cecf3d")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "6. Surface finish ENIG. LPI solder mask both sides, Dk about 3.8."
		(at 30 180.6 0)
		(layer "User.3")
		(uuid "57e2ff5c-d1c5-4afb-ab20-48240fd44215")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "7. Vias are plated through-holes, smallest finished hole 0.3 mm, tented both sides."
		(at 30 183 0)
		(layer "User.3")
		(uuid "b54f69b1-c842-4ccd-814c-a7c1d9949632")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "8. Outline routed, ±0.2 mm or better. The two 79.5 mm edges slide in card guides: no V-cut,"
		(at 30 185.4 0)
		(layer "User.3")
		(uuid "a5b948fd-de8d-47aa-831d-5f9b5273f5e8")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   and no break-off tabs or tab remains on any edge. The solder mask is open along those"
		(at 30 187.8 0)
		(layer "User.3")
		(uuid "6f0cd6eb-b92a-4348-90d7-f03109e96e76")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   two edges on purpose: 3 mm strips of bare laminate, both sides."
		(at 30 190.2 0)
		(layer "User.3")
		(uuid "ab39fdc6-2c20-4137-b07e-23fdb58d653f")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
