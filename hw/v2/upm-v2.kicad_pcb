	(gr_text "1. Board 79.5 x 60.0 x 1.6 mm. It slides into the extrusion's card guides along"
		(at 30 126.4 0)
		(layer "User.1")
		(uuid "67478623-f77c-40f3-bd2d-e0cd18916a80")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   the 79.5 mm edges and is held by the two bezels. No mounting holes."
		(at 30 128.8 0)
		(layer "User.1")
		(uuid "27dd1d32-eb69-424e-b9b5-5bfd3c471e54")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "2. Length: the extrusion is 81.0 ±0.5 and each bezel reaches 0.5 into it, which leaves"
		(at 30 131.2 0)
		(layer "User.1")
		(uuid "e5134f1f-99cc-4e55-b3cd-506bf359f674")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   79.5 to 80.5 mm between the bezels. 79.5 fits the shortest."
		(at 30 133.6 0)
		(layer "User.1")
		(uuid "ab694fb5-df47-4e0f-8aad-cbf1155afc64")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "3. Width: the guides are 61.88 ±0.51 apart at their bottoms and 2.29 deep, 1.63 high."
		(at 30 136 0)
		(layer "User.1")
		(uuid "4d52204b-01ac-48ee-a9b9-2dca91e73f3f")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "4. Rail strips, 3.0 mm along both long edges, both sides: no parts, no copper on L1 / L4,"
