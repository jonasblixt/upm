				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "   2.5 mm past the board end. Bezel opening 10.2 x 4.0 mm, in the middle of the bezel's"
		(locked yes)
		(at 30 157.2 0)
		(layer "User.1")
		(uuid "f234b531-1209-4bd3-9364-9f563931ad11")
		(effects
